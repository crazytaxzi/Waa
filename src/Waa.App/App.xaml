<Application x:Class="Waa.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#F4F5F6" />
        <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="PanelSubtleBackgroundBrush" Color="#F7F8F9" />
        <SolidColorBrush x:Key="BorderBrush" Color="#D7DBDF" />
        <SolidColorBrush x:Key="ControlBorderBrush" Color="#BFC6CC" />
        <SolidColorBrush x:Key="ControlBackgroundBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="ControlHoverBrush" Color="#EEF2F4" />
        <SolidColorBrush x:Key="ControlDisabledBrush" Color="#E8EBED" />
        <SolidColorBrush x:Key="PrimaryBrush" Color="#22577A" />
        <SolidColorBrush x:Key="PrimaryHoverBrush" Color="#194764" />
        <SolidColorBrush x:Key="TextBrush" Color="#1F2933" />
        <SolidColorBrush x:Key="SubtleTextBrush" Color="#5F6B73" />
        <SolidColorBrush x:Key="SelectionBrush" Color="#A9D0E8" />
        <SolidColorBrush x:Key="DataGridRowBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="DataGridAltRowBrush" Color="#FAFBFB" />
        <SolidColorBrush x:Key="DataGridHeaderBrush" Color="#ECEFF1" />
        <SolidColorBrush x:Key="DataGridHeaderTextBrush" Color="#253238" />
        <SolidColorBrush x:Key="DataGridHorizontalLineBrush" Color="#E6E8EA" />
        <SolidColorBrush x:Key="DataGridVerticalLineBrush" Color="#EEF0F1" />
        <SolidColorBrush x:Key="SelectedRowBrush" Color="#DCEBF5" />
        <SolidColorBrush x:Key="SelectedRowTextBrush" Color="#111111" />
        <SolidColorBrush x:Key="WarningTextBrush" Color="#B22222" />
        <SolidColorBrush x:Key="FollowUpTextBrush" Color="#8A6200" />
        <SolidColorBrush x:Key="CompletedTextBrush" Color="#207A3C" />
        <SolidColorBrush x:Key="QuietTextBrush" Color="#65717A" />

        <Style TargetType="{x:Type Window}">
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
            <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
        </Style>

        <Style TargetType="{x:Type Button}">
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ControlHoverBrush}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="{DynamicResource ControlDisabledBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource SubtleTextBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PrimaryButtonStyle"
               TargetType="{x:Type Button}"
               BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="{DynamicResource PrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource PrimaryHoverBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource PrimaryHoverBrush}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="{DynamicResource ControlDisabledBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource ControlDisabledBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource SubtleTextBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="{x:Type TextBox}">
            <Setter Property="Padding" Value="7,5" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="CaretBrush" Value="{DynamicResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
            <Setter Property="SelectionBrush" Value="{DynamicResource SelectionBrush}" />
        </Style>

        <Style TargetType="{x:Type ToolTip}">
            <Setter Property="Background" Value="{DynamicResource PanelSubtleBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        </Style>

        <Style TargetType="{x:Type DataGrid}">
            <Setter Property="Background" Value="{DynamicResource DataGridRowBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource DataGridHorizontalLineBrush}" />
            <Setter Property="VerticalGridLinesBrush" Value="{DynamicResource DataGridVerticalLineBrush}" />
            <Setter Property="RowBackground" Value="{DynamicResource DataGridRowBrush}" />
            <Setter Property="AlternatingRowBackground" Value="{DynamicResource DataGridAltRowBrush}" />
        </Style>

        <Style TargetType="{x:Type DataGridColumnHeader}">
            <Setter Property="Background" Value="{DynamicResource DataGridHeaderBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource DataGridHeaderTextBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="7,7" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
        </Style>

        <Style TargetType="{x:Type DataGridRow}">
            <Setter Property="MinHeight" Value="37" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SelectedRowBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource SelectedRowTextBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="{x:Type DataGridCell}">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DataGridHorizontalLineBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SelectedRowBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource SelectedRowTextBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource SelectedRowBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Application.Resources>
</Application>
