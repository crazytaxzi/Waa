<Window x:Class="Waa.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WAA — Driver Work Queue"
        Width="1280"
        Height="780"
        MinWidth="1050"
        MinHeight="650"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBackgroundBrush}">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Padding="14,12"
                Background="{StaticResource PanelBackgroundBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="260" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock FontSize="20" FontWeight="SemiBold" Text="Driver Work Queue" />
                    <TextBlock Margin="0,3,0,0"
                               Foreground="{StaticResource SubtleTextBrush}"
                               Text="Weighted idle and contact accountability" />
                </StackPanel>

                <UniformGrid Grid.Column="1" Columns="4" Margin="16,0">
                    <StackPanel Margin="8,0">
                        <TextBlock Foreground="{StaticResource SubtleTextBrush}" Text="Report cycle" />
                        <TextBlock Margin="0,3,0,0" FontSize="15" FontWeight="SemiBold" Text="{Binding ReportCycleText}" />
                    </StackPanel>
                    <StackPanel Margin="8,0">
                        <TextBlock Foreground="{StaticResource SubtleTextBrush}" Text="Fleet 28-day" />
                        <TextBlock Margin="0,3,0,0" FontSize="15" FontWeight="SemiBold" Text="{Binding Fleet28DayText}" />
                    </StackPanel>
                    <StackPanel Margin="8,0">
                        <TextBlock Foreground="{StaticResource SubtleTextBrush}" Text="Fleet 7-day" />
                        <TextBlock Margin="0,3,0,0" FontSize="15" FontWeight="SemiBold" Text="{Binding Fleet7DayText}" />
                    </StackPanel>
                    <StackPanel Margin="8,0">
                        <TextBlock Foreground="{StaticResource SubtleTextBrush}" Text="Idle contact" />
                        <TextBlock Margin="0,3,0,0" FontSize="15" FontWeight="SemiBold" Text="{Binding ContactProgressText}" />
                    </StackPanel>
                </UniformGrid>

                <Button Grid.Column="2"
                        Margin="8,0,0,0"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Command="{Binding UpdateReportsCommand}"
                        Content="Update Reports" />
            </Grid>
        </Border>

        <Border Grid.Row="1"
                Margin="0,10,0,10"
                Padding="10"
                Background="{StaticResource PanelBackgroundBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="72" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0"
                         Margin="0,0,12,0"
                         VerticalContentAlignment="Center"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Search by driver code, name, unit, or Driver Leader" />

                <TextBlock Grid.Column="1"
                           Margin="0,0,7,0"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource SubtleTextBrush}"
                           Text="Idle threshold" />
                <TextBox Grid.Column="2"
                         HorizontalContentAlignment="Right"
                         Text="{Binding ThresholdText, UpdateSourceTrigger=PropertyChanged}" />
                <Button Grid.Column="3"
                        Margin="8,0,0,0"
                        Command="{Binding ApplyThresholdCommand}"
                        Content="Apply" />
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" MinWidth="650" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="2*" MinWidth="340" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{StaticResource PanelBackgroundBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1">
                <DataGrid ItemsSource="{Binding Drivers}"
                          SelectedItem="{Binding SelectedDriver, Mode=TwoWay}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          CanUserReorderColumns="False"
                          CanUserResizeRows="False"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          SelectionMode="Single"
                          SelectionUnit="FullRow"
                          AlternationCount="2"
                          EnableRowVirtualization="True"
                          EnableColumnVirtualization="True"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          ScrollViewer.CanContentScroll="True">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Status" Width="94">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Margin="6,0"
                                               VerticalAlignment="Center"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="{Binding AttentionBrush}"
                                               Text="{Binding AttentionText}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Code" Binding="{Binding DriverCode}" Width="70" />
                        <DataGridTextColumn Header="Driver" Binding="{Binding DriverName}" Width="*" MinWidth="155" />
                        <DataGridTextColumn Header="Unit" Binding="{Binding UnitCode}" Width="74" />
                        <DataGridTextColumn Header="Leader" Binding="{Binding DriverLeader}" Width="70" />
                        <DataGridTemplateColumn Header="28-day" Width="96">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Margin="6,0"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center"
                                               FontWeight="{Binding Idle28FontWeight}"
                                               Foreground="{Binding Idle28Brush}"
                                               Text="{Binding Idle28Display}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="7-day" Width="72">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Margin="6,0"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center"
                                               FontWeight="{Binding Idle7FontWeight}"
                                               Foreground="{Binding Idle7Brush}"
                                               Text="{Binding Idle7Display}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Idle contact" Binding="{Binding ContactDisplay}" Width="128" />
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <Border Grid.Column="2"
                    Padding="16"
                    Background="{StaticResource PanelBackgroundBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock FontSize="12"
                                   Foreground="{StaticResource SubtleTextBrush}"
                                   Text="SELECTED DRIVER" />
                        <TextBlock Margin="0,5,0,0"
                                   FontSize="21"
                                   FontWeight="SemiBold"
                                   Text="{Binding SelectedDriver.DriverName, TargetNullValue=Select a driver}" />
                        <TextBlock Margin="0,4,0,14"
                                   Foreground="{StaticResource SubtleTextBrush}"
                                   Text="{Binding SelectedDriver.IdentityLine}" />

                        <Border Padding="12"
                                Background="#F7F8F9"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                    <TextBlock Foreground="{StaticResource SubtleTextBrush}" Text="Weighted 28-day" />
                                    <TextBlock Margin="0,4,0,0"
                                               FontSize="24"
                                               FontWeight="SemiBold"
                                               Foreground="{Binding SelectedDriver.Idle28Brush}"
                                               Text="{Binding SelectedDriver.Idle28Display}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                    <TextBlock Foreground="{StaticResource SubtleTextBrush}" Text="Weighted 7-day" />
                                    <TextBlock Margin="0,4,0,0"
                                               FontSize="24"
                                               FontWeight="SemiBold"
                                               Foreground="{Binding SelectedDriver.Idle7Brush}"
                                               Text="{Binding SelectedDriver.Idle7Display}" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <TextBlock Margin="0,16,0,4"
                                   FontWeight="SemiBold"
                                   Text="Current-cycle idle contact" />
                        <TextBlock Margin="0,0,0,10"
                                   Foreground="{StaticResource SubtleTextBrush}"
                                   Text="{Binding SelectedDriver.ContactDisplay}" />

                        <TextBlock Margin="0,4,0,4" Text="Optional note" />
                        <TextBox MinHeight="76"
                                 MaxLength="500"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalContentAlignment="Top"
                                 Text="{Binding ContactNote, UpdateSourceTrigger=PropertyChanged}" />

                        <WrapPanel Margin="0,12,0,0">
                            <Button Style="{StaticResource PrimaryButtonStyle}"
                                    Command="{Binding SpokeCommand}"
                                    Content="Spoke" />
                            <Button Command="{Binding AttemptedCommand}"
                                    Content="Attempted" />
                        </WrapPanel>
                        <Button Margin="0,8,0,0"
                                HorizontalAlignment="Left"
                                Command="{Binding FollowUpCommand}"
                                Content="Spoke — Follow-up" />

                        <Border Margin="0,18,0,0"
                                Padding="10"
                                Background="#F7F8F9"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1">
                            <TextBlock Foreground="{StaticResource SubtleTextBrush}"
                                       TextWrapping="Wrap"
                                       Text="Saving an outcome updates the queue immediately. A new report cycle creates fresh contact status without deleting prior weeks." />
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <Border Grid.Row="3"
                Margin="0,10,0,0"
                Padding="10,7"
                Background="{StaticResource PanelBackgroundBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center" Text="{Binding StatusMessage}" />
                <TextBlock Grid.Column="1"
                           Margin="16,0,0,0"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource SubtleTextBrush}"
                           Text="{Binding RosterSummaryText}" />
            </Grid>
        </Border>
    </Grid>
</Window>
