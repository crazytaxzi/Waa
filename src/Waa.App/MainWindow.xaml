<Window x:Class="Waa.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
        Title="WAA — Work Accountability Assistant"
        Width="1320"
        Height="820"
        MinWidth="980"
        MinHeight="650"
        WindowStartupLocation="CenterScreen"
        PreviewKeyDown="OnPreviewKeyDown">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource PanelCardStyle}" Padding="14,11">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="WAA" FontSize="23" FontWeight="SemiBold" />
                    <TextBlock Text="Work Accountability Assistant"
                               Style="{StaticResource SubtleTextStyle}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="28,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding RosterSummaryText}" FontWeight="SemiBold" />
                    <TextBlock Style="{StaticResource SubtleTextStyle}">
                        <Run Text="Cycle " />
                        <Run Text="{Binding ReportCycleText, Mode=OneWay}" />
                        <Run Text="  •  " />
                        <Run Text="{Binding MissingBolSummaryText, Mode=OneWay}" />
                    </TextBlock>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="ThemeToggleButton"
                            Margin="0,0,8,0"
                            Click="OnThemeToggleClicked"
                            automation:AutomationProperties.Name="Switch light or dark appearance" />
                    <Button Margin="0,0,8,0"
                            Content="Update Reports"
                            Command="{Binding UpdateReportsCommand}"
                            automation:AutomationProperties.Name="Update reports from Downloads" />
                    <Button Content="Handoff"
                            Command="{Binding OpenHandoffCommand}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            automation:AutomationProperties.Name="Open shift handoff workspace" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1"
                Margin="0,10,0,0"
                Padding="10,7"
                Background="{DynamicResource PanelSubtleBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="4"
                Visibility="{Binding CanGoBack, Converter={StaticResource BooleanToVisibilityConverter}}">
            <DockPanel LastChildFill="True">
                <Button DockPanel.Dock="Left"
                        Margin="0,0,12,0"
                        Content="{Binding BackLabel}"
                        Command="{Binding BackCommand}"
                        Style="{StaticResource LinkButtonStyle}"
                        automation:AutomationProperties.Name="{Binding BackLabel}" />
                <TextBlock Text="{Binding BreadcrumbText}"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis"
                           automation:AutomationProperties.Name="Current workspace breadcrumb" />
            </DockPanel>
        </Border>

        <ContentControl Grid.Row="2"
                        Margin="0,10,0,10"
                        Content="{Binding CurrentWorkspace}"
                        HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Stretch"
                        automation:AutomationProperties.Name="Central operations workspace" />

        <Border Grid.Row="3"
                Padding="10,7"
                Background="{DynamicResource PanelSubtleBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="4">
            <DockPanel LastChildFill="True">
                <TextBlock DockPanel.Dock="Right"
                           Margin="16,0,0,0"
                           Text="{Binding ContactProgressText}"
                           Style="{StaticResource SubtleTextStyle}"
                           VerticalAlignment="Center" />
                <TextBlock Text="{Binding StatusMessage}"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           automation:AutomationProperties.LiveSetting="Polite"
                           automation:AutomationProperties.Name="Application status" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
