<UserControl x:Class="Waa.App.Views.ActivityDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="900" HorizontalAlignment="Center">
            <Border Style="{StaticResource PanelCardStyle}">
                <StackPanel>
                    <TextBlock Text="Activity Detail" Style="{StaticResource PageTitleStyle}" />
                    <TextBlock Margin="0,3,0,0" Text="{Binding Driver.DriverName}" FontSize="17" FontWeight="SemiBold" />
                    <TextBlock Margin="0,2,0,0" Text="{Binding Driver.IdentityLine}" Style="{StaticResource SubtleTextStyle}" />
                </StackPanel>
            </Border>

            <Border Margin="0,10,0,0" Style="{StaticResource PanelCardStyle}">
                <StackPanel>
                    <TextBlock Text="ACTIVITY" Style="{StaticResource SectionTitleStyle}" />
                    <TextBlock Text="{Binding Item.Text}" FontSize="16" />
                </StackPanel>
            </Border>

            <Border Margin="0,10,0,0" Style="{StaticResource PanelCardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="155" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="155" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Source" Style="{StaticResource SubtleTextStyle}" />
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Item.SourceDisplay}" />
                    <TextBlock Grid.Row="0" Grid.Column="2" Text="Status" Style="{StaticResource SubtleTextStyle}" />
                    <TextBlock Grid.Row="0" Grid.Column="3" Text="{Binding Item.StatusDisplay}" FontWeight="SemiBold" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,9,0,0" Text="Created" Style="{StaticResource SubtleTextStyle}" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,9,0,0" Text="{Binding Item.CreatedFullDisplay}" />
                    <TextBlock Grid.Row="1" Grid.Column="2" Margin="0,9,0,0" Text="Resolution" Style="{StaticResource SubtleTextStyle}" />
                    <TextBlock Grid.Row="1" Grid.Column="3" Margin="0,9,0,0" Text="{Binding Item.ResolutionDisplay}" />

                    <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,9,0,0" Text="Unit Snapshot" Style="{StaticResource SubtleTextStyle}" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Margin="0,9,0,0" Text="{Binding Item.UnitCodeDisplay}" />
                    <TextBlock Grid.Row="2" Grid.Column="2" Margin="0,9,0,0" Text="Leader Snapshot" Style="{StaticResource SubtleTextStyle}" />
                    <TextBlock Grid.Row="2" Grid.Column="3" Margin="0,9,0,0" Text="{Binding Item.DriverLeaderDisplay}" />

                    <TextBlock Grid.Row="3" Grid.Column="0" Margin="0,9,0,0" Text="Report Cycle" Style="{StaticResource SubtleTextStyle}" />
                    <TextBlock Grid.Row="3" Grid.Column="1" Margin="0,9,0,0" Text="{Binding Item.ReportCycleDisplay}" />
                    <TextBlock Grid.Row="3" Grid.Column="2" Margin="0,9,0,0" Text="Driver Code" Style="{StaticResource SubtleTextStyle}" />
                    <TextBlock Grid.Row="3" Grid.Column="3" Margin="0,9,0,0" Text="{Binding Driver.DriverCode}" />
                </Grid>
            </Border>

            <Border Margin="0,10,0,0"
                    Padding="12,9"
                    Background="{DynamicResource QuietBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="4">
                <TextBlock Text="This page is read-only. Activity records are historical evidence and are not edited or deleted here."
                           Style="{StaticResource QuietTextStyle}" />
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
