<UserControl x:Class="Waa.App.Views.DriverWorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Waa.App.ViewModels"
             xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <Border Style="{StaticResource PanelCardStyle}">
                <StackPanel>
                    <TextBlock Text="{Binding Driver.DriverName}" Style="{StaticResource PageTitleStyle}" />
                    <TextBlock Margin="0,3,0,0" Text="{Binding Driver.IdentityLine}" Style="{StaticResource SubtleTextStyle}" />
                    <TextBlock Margin="0,3,0,0" Style="{StaticResource SubtleTextStyle}">
                        <Run Text="Report cycle " />
                        <Run Text="{Binding Driver.Record.ReportCycleDate, Mode=OneWay, StringFormat={}{0:M/d/yyyy}}" />
                    </TextBlock>
                    <UniformGrid Margin="0,14,0,0" Columns="5">
                        <Border Margin="0,0,6,0" Style="{StaticResource SubtlePanelStyle}">
                            <StackPanel><TextBlock Text="28 Day Idle" Style="{StaticResource SubtleTextStyle}" /><TextBlock Margin="0,3,0,0" Text="{Binding Driver.Idle28Display}" FontWeight="SemiBold" FontSize="16" /></StackPanel>
                        </Border>
                        <Border Margin="2,0,4,0" Style="{StaticResource SubtlePanelStyle}">
                            <StackPanel><TextBlock Text="7 Day Idle" Style="{StaticResource SubtleTextStyle}" /><TextBlock Margin="0,3,0,0" Text="{Binding Driver.Idle7Display}" FontWeight="SemiBold" FontSize="16" /></StackPanel>
                        </Border>
                        <Border Margin="3,0" Style="{StaticResource SubtlePanelStyle}">
                            <StackPanel><TextBlock Text="Idle Contact" Style="{StaticResource SubtleTextStyle}" /><TextBlock Margin="0,3,0,0" Text="{Binding Driver.ContactDisplay}" FontWeight="SemiBold" /></StackPanel>
                        </Border>
                        <Border Margin="4,0,2,0" Style="{StaticResource SubtlePanelStyle}">
                            <StackPanel><TextBlock Text="Open Work" Style="{StaticResource SubtleTextStyle}" /><TextBlock Margin="0,3,0,0" Text="{Binding Driver.OpenWorkCount}" FontWeight="SemiBold" FontSize="16" /></StackPanel>
                        </Border>
                        <Border Margin="6,0,0,0" Style="{StaticResource SubtlePanelStyle}">
                            <StackPanel><TextBlock Text="Missing BOL" Style="{StaticResource SubtleTextStyle}" /><TextBlock Margin="0,3,0,0" Text="{Binding Driver.MissingBolCount}" FontWeight="SemiBold" FontSize="16" /></StackPanel>
                        </Border>
                    </UniformGrid>
                </StackPanel>
            </Border>

            <TextBlock Margin="2,10,2,0"
                       Text="{Binding FocusDescription}"
                       Style="{StaticResource InformationTextStyle}"
                       Visibility="{Binding HasFocusDescription, Converter={StaticResource BooleanToVisibilityConverter}}" />

            <Border Margin="0,10,0,0" Style="{StaticResource PanelCardStyle}">
                <StackPanel>
                    <TextBlock Text="NEEDS ATTENTION" Style="{StaticResource SectionTitleStyle}" />
                    <ItemsControl ItemsSource="{Binding NeedsAttention}"
                                  Visibility="{Binding HasNeedsAttention, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Command="{Binding DataContext.OpenAttentionItemCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                        CommandParameter="{Binding}"
                                        Style="{StaticResource ClickableRowButtonStyle}"
                                        automation:AutomationProperties.Name="{Binding Title}">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="110" /><ColumnDefinition Width="*" /><ColumnDefinition Width="150" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding TypeLabel}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" Margin="10,0">
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                            <TextBlock Margin="0,2,0,0" Text="{Binding ContextText}" Style="{StaticResource SubtleTextStyle}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Margin="8,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding StatusText}" HorizontalAlignment="Right">
                                                <TextBlock.Style>
                                                    <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource QuietTextStyle}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SemanticState}" Value="{x:Static vm:SemanticState.Warning}"><Setter Property="Foreground" Value="{DynamicResource WarningTextBrush}" /><Setter Property="FontWeight" Value="SemiBold" /></DataTrigger>
                                                            <DataTrigger Binding="{Binding SemanticState}" Value="{x:Static vm:SemanticState.FollowUp}"><Setter Property="Foreground" Value="{DynamicResource FollowUpTextBrush}" /><Setter Property="FontWeight" Value="SemiBold" /></DataTrigger>
                                                            <DataTrigger Binding="{Binding SemanticState}" Value="{x:Static vm:SemanticState.Information}"><Setter Property="Foreground" Value="{DynamicResource InformationTextBrush}" /><Setter Property="FontWeight" Value="SemiBold" /></DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Margin="0,2,0,0" Text="{Binding DateText}" HorizontalAlignment="Right" Style="{StaticResource SubtleTextStyle}" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="3" Margin="10,0,0,0" Text="›" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{Binding EmptyStateText}">
                        <TextBlock.Style>
                            <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource SubtleTextStyle}">
                                <Style.Triggers><DataTrigger Binding="{Binding HasNeedsAttention}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>

            <Border Margin="0,10,0,0" Style="{StaticResource PanelCardStyle}">
                <StackPanel>
                    <TextBlock Text="CURRENT MISSING BOL" Style="{StaticResource SectionTitleStyle}" />
                    <TextBlock Margin="0,2,0,8"
                               Text="Current workbook only — read-only and not stored as work or history."
                               Style="{StaticResource SubtleTextStyle}" />
                    <ItemsControl ItemsSource="{Binding DataContext.MissingBol.Items, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                  Visibility="{Binding DataContext.MissingBol.HasItems, RelativeSource={RelativeSource AncestorType={x:Type Window}}, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Command="{Binding DataContext.OpenAttentionItemCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                        CommandParameter="{Binding AttentionItem}"
                                        Style="{StaticResource ClickableRowButtonStyle}"
                                        automation:AutomationProperties.Name="{Binding OrderNumber}">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="120" /><ColumnDefinition Width="*" /><ColumnDefinition Width="160" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding OrderNumber}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" Margin="10,0">
                                            <TextBlock Text="{Binding RouteDisplay}" />
                                            <TextBlock Margin="0,2,0,0" Text="{Binding CustomerDisplay}" Style="{StaticResource SubtleTextStyle}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Margin="8,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding StatusDisplay}" HorizontalAlignment="Right" Foreground="{DynamicResource InformationTextBrush}" FontWeight="SemiBold" />
                                            <TextBlock Margin="0,2,0,0" Text="{Binding EmptyCallDateDisplay}" HorizontalAlignment="Right" Style="{StaticResource SubtleTextStyle}" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="3" Margin="10,0,0,0" Text="›" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="No Missing BOL orders for this driver in the current workbook.">
                        <TextBlock.Style>
                            <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource SubtleTextStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DataContext.MissingBol.HasItems, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>

            <Border Margin="0,10,0,0" Style="{StaticResource PanelCardStyle}">
                <StackPanel>
                    <TextBlock Text="QUICK ACTIONS" Style="{StaticResource SectionTitleStyle}" />
                    <WrapPanel>
                        <Button Margin="0,0,8,8" Content="Add Work" Command="{Binding DataContext.OpenNewWorkCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Style="{StaticResource PrimaryButtonStyle}" automation:AutomationProperties.Name="Add manual work for this driver" />
                        <Button Margin="0,0,8,8" Content="Next Work Item" Command="{Binding DataContext.NextWorkItemCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" automation:AutomationProperties.Name="Open next work item for this driver" />
                        <Button Margin="0,0,8,8" Content="Missing BOL" Command="{Binding DataContext.OpenDriverMissingBolCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" CommandParameter="{Binding Driver}" automation:AutomationProperties.Name="Focus current Missing BOL report" />
                        <Button Margin="0,0,8,8" Content="Open Work" Command="{Binding DataContext.OpenDriverWorkCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" CommandParameter="{Binding Driver}" automation:AutomationProperties.Name="Focus open manual work" />
                        <Button Margin="0,0,0,8" Content="Next Needing Attention" Command="{Binding DataContext.NextNeedingAttentionCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" automation:AutomationProperties.Name="Open next visible driver needing attention" />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <Border Margin="0,10,0,0" Style="{StaticResource PanelCardStyle}">
                <StackPanel>
                    <TextBlock Text="TODAY'S ACTIVITY" Style="{StaticResource SectionTitleStyle}" />
                    <ItemsControl ItemsSource="{Binding RecentActivity}" Visibility="{Binding HasRecentActivity, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Command="{Binding DataContext.OpenActivityDetailCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                        CommandParameter="{Binding}"
                                        Style="{StaticResource ClickableRowButtonStyle}"
                                        automation:AutomationProperties.Name="Open read-only activity detail">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="100" /><ColumnDefinition Width="*" /><ColumnDefinition Width="150" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding StatusDisplay}" FontWeight="SemiBold" />
                                        <TextBlock Grid.Column="1" Margin="10,0" Text="{Binding Text}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="2" Margin="8,0" Text="{Binding CreatedDisplay}" HorizontalAlignment="Right" Style="{StaticResource SubtleTextStyle}" />
                                        <TextBlock Grid.Column="3" Margin="10,0,0,0" Text="›" FontSize="20" />
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{Binding ActivityEmptyText}">
                        <TextBlock.Style>
                            <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource SubtleTextStyle}">
                                <Style.Triggers><DataTrigger Binding="{Binding HasRecentActivity}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>