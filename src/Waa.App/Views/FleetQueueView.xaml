<UserControl x:Class="Waa.App.Views.FleetQueueView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Style="{StaticResource PanelCardStyle}"
                Padding="12,9">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                    <TextBlock Text="Search fleet" FontWeight="SemiBold" />
                    <TextBox Margin="0,4,0,0"
                             Text="{Binding DataContext.SearchText, RelativeSource={RelativeSource AncestorType={x:Type Window}}, UpdateSourceTrigger=PropertyChanged}"
                             automation:AutomationProperties.Name="Search fleet by driver, unit, leader, or order number" />
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="0,0,12,0">
                    <TextBlock Text="Idle threshold %" FontWeight="SemiBold" />
                    <StackPanel Margin="0,4,0,0" Orientation="Horizontal">
                        <TextBox Width="86"
                                 Text="{Binding DataContext.ThresholdText, RelativeSource={RelativeSource AncestorType={x:Type Window}}, UpdateSourceTrigger=PropertyChanged}"
                                 automation:AutomationProperties.Name="Idle threshold percentage" />
                        <Button Margin="7,0,0,0"
                                Content="Apply"
                                Command="{Binding DataContext.ApplyThresholdCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                automation:AutomationProperties.Name="Apply idle threshold" />
                    </StackPanel>
                </StackPanel>

                <Button Grid.Column="2"
                        Margin="0,19,8,0"
                        Content="{Binding DataContext.UnmatchedBolButtonText, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                        Command="{Binding DataContext.OpenUnmatchedBolCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                        automation:AutomationProperties.Name="Open unmatched Missing BOL workspace" />

                <Button Grid.Column="3"
                        Margin="0,19,0,0"
                        Content="Next Needing Attention"
                        Command="{Binding DataContext.NextNeedingAttentionCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                        Style="{StaticResource SuccessButtonStyle}"
                        automation:AutomationProperties.Name="Select next visible driver needing attention" />
            </Grid>
        </Border>

        <UniformGrid Grid.Row="1" Margin="0,7,0,7" Columns="4">
            <Border Margin="0,0,7,0"
                    Padding="11,7"
                    Style="{StaticResource SubtlePanelStyle}">
                <StackPanel>
                    <TextBlock Text="Fleet 28 Day" Style="{StaticResource SubtleTextStyle}" />
                    <TextBlock Margin="0,2,0,0"
                               Text="{Binding DataContext.Fleet28DayText, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                               FontSize="17"
                               FontWeight="SemiBold" />
                </StackPanel>
            </Border>
            <Border Margin="2,0,5,0"
                    Padding="11,7"
                    Style="{StaticResource SubtlePanelStyle}">
                <StackPanel>
                    <TextBlock Text="Fleet 7 Day" Style="{StaticResource SubtleTextStyle}" />
                    <TextBlock Margin="0,2,0,0"
                               Text="{Binding DataContext.Fleet7DayText, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                               FontSize="17"
                               FontWeight="SemiBold" />
                </StackPanel>
            </Border>
            <Border Margin="4,0,3,0"
                    Padding="11,7"
                    Style="{StaticResource SubtlePanelStyle}">
                <StackPanel>
                    <TextBlock Text="Current Cycle" Style="{StaticResource SubtleTextStyle}" />
                    <TextBlock Margin="0,2,0,0"
                               Text="{Binding DataContext.ReportCycleText, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                               FontSize="17"
                               FontWeight="SemiBold" />
                </StackPanel>
            </Border>
            <Border Margin="6,0,0,0"
                    Padding="11,7"
                    Style="{StaticResource SubtlePanelStyle}">
                <StackPanel>
                    <TextBlock Text="Queue Status" Style="{StaticResource SubtleTextStyle}" />
                    <TextBlock Margin="0,2,0,0"
                               Text="{Binding DataContext.ContactProgressText, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                               FontWeight="SemiBold" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <Border Grid.Row="2" Style="{StaticResource PanelCardStyle}" Padding="0">
            <Grid>
                <DataGrid x:Name="FleetGrid"
                          ItemsSource="{Binding DataContext.Drivers, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                          SelectedItem="{Binding DataContext.SelectedDriver, RelativeSource={RelativeSource AncestorType={x:Type Window}}, Mode=TwoWay}"
                          AlternationCount="2"
                          EnableRowVirtualization="True"
                          EnableColumnVirtualization="True"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          ScrollViewer.CanContentScroll="True"
                          RowStyle="{StaticResource CompactFleetDataGridRowStyle}"
                          CellStyle="{StaticResource CompactFleetDataGridCellStyle}"
                          PreviewMouseLeftButtonUp="OnFleetGridMouseLeftButtonUp"
                          PreviewKeyDown="OnFleetGridPreviewKeyDown"
                          Loaded="OnFleetGridLoaded"
                          automation:AutomationProperties.Name="Fleet driver queue">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Driver / Unit" Width="2.35*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock Text="{Binding DriverName}"
                                                   FontWeight="SemiBold"
                                                   Style="{DynamicResource DataGridTextElementStyle}" />
                                        <TextBlock Text="{Binding FleetIdentityLine}"
                                                   FontSize="12"
                                                   Style="{DynamicResource DataGridTextElementStyle}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Leader"
                                            Width="1.05*"
                                            Binding="{Binding DriverLeader}"
                                            ElementStyle="{DynamicResource DataGridTextElementStyle}"
                                            EditingElementStyle="{DynamicResource DataGridTextEditingElementStyle}" />
                        <DataGridTextColumn Header="28 Day"
                                            Width="0.9*"
                                            Binding="{Binding Idle28Display}"
                                            ElementStyle="{DynamicResource DataGridTextElementStyle}"
                                            EditingElementStyle="{DynamicResource DataGridTextEditingElementStyle}" />
                        <DataGridTextColumn Header="7 Day"
                                            Width="0.8*"
                                            Binding="{Binding Idle7Display}"
                                            ElementStyle="{DynamicResource DataGridTextElementStyle}"
                                            EditingElementStyle="{DynamicResource DataGridTextEditingElementStyle}" />
                        <DataGridTextColumn Header="Status"
                                            Width="1.1*"
                                            Binding="{Binding AttentionText}"
                                            ElementStyle="{DynamicResource DataGridTextElementStyle}"
                                            EditingElementStyle="{DynamicResource DataGridTextEditingElementStyle}" />
                        <DataGridTextColumn Header="BOL"
                                            Width="0.55*"
                                            Binding="{Binding MissingBolDisplay}"
                                            ElementStyle="{DynamicResource DataGridTextElementStyle}"
                                            EditingElementStyle="{DynamicResource DataGridTextEditingElementStyle}" />
                        <DataGridTextColumn Header="Open Work"
                                            Width="0.85*"
                                            Binding="{Binding OpenWorkDisplay}"
                                            ElementStyle="{DynamicResource DataGridTextElementStyle}"
                                            EditingElementStyle="{DynamicResource DataGridTextEditingElementStyle}" />
                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock Margin="24"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Text="No drivers match the current search."
                           Style="{StaticResource SubtleTextStyle}"
                           Visibility="{Binding DataContext.HasNoVisibleDrivers, RelativeSource={RelativeSource AncestorType={x:Type Window}}, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
