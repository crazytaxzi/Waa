<UserControl x:Class="Waa.App.Views.HandoffView"
   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
   xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore">
    <Grid>
        <Grid.RowDefinitions>
  <RowDefinition Height="Auto" />
  <RowDefinition Height="*" />
  <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource PanelCardStyle}">
  <Grid>
      <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel>
          <TextBlock Text="Shift Handoff" Style="{StaticResource PageTitleStyle}" />
          <TextBlock Margin="0,3,0,0"
                     Text="{Binding DataContext.Handoff.SummaryText, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                     Style="{StaticResource SubtleTextStyle}" />
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Margin="0,0,8,0"
                  Content="Regenerate"
                  Command="{Binding DataContext.Handoff.RegenerateCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                  automation:AutomationProperties.Name="Regenerate handoff from saved work" />
          <Button Content="Copy to Clipboard"
                  Command="{Binding DataContext.Handoff.CopyCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                  Style="{StaticResource PrimaryButtonStyle}"
                  automation:AutomationProperties.Name="Copy current handoff draft to clipboard" />
      </StackPanel>
  </Grid>
        </Border>

        <Border Grid.Row="1" Margin="0,10,0,0" Style="{StaticResource PanelCardStyle}" Padding="10">
  <TextBox AcceptsReturn="True"
           AcceptsTab="True"
           TextWrapping="NoWrap"
           VerticalContentAlignment="Top"
           VerticalScrollBarVisibility="Auto"
           HorizontalScrollBarVisibility="Auto"
           FontFamily="Consolas"
           Text="{Binding DataContext.Handoff.DraftText, RelativeSource={RelativeSource AncestorType={x:Type Window}}, UpdateSourceTrigger=PropertyChanged}"
           automation:AutomationProperties.Name="Editable shift handoff draft" />
        </Border>

        <Border Grid.Row="2" Margin="0,10,0,0" Style="{StaticResource PanelCardStyle}" Padding="10">
  <StackPanel>
      <TextBlock Text="Worked items in this Handoff" FontWeight="SemiBold" />
      <TextBlock Margin="0,3,0,8"
                 Text="Remove hides a completed item from future regenerated Handoffs. The saved work/history record is not deleted. Open Waiting or Follow-up work cannot be removed here. Removing an item regenerates the draft."
                 TextWrapping="Wrap"
                 Style="{StaticResource SubtleTextStyle}" />
      <TextBlock Text="No completed work items are currently included.">
          <TextBlock.Style>
              <Style TargetType="TextBlock" BasedOn="{StaticResource SubtleTextStyle}">
                  <Setter Property="Visibility" Value="Collapsed" />
                  <Style.Triggers>
                      <DataTrigger Binding="{Binding DataContext.Handoff.HasWorkedItems, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Value="False">
                          <Setter Property="Visibility" Value="Visible" />
                      </DataTrigger>
                  </Style.Triggers>
              </Style>
          </TextBlock.Style>
      </TextBlock>
      <ScrollViewer MaxHeight="180" VerticalScrollBarVisibility="Auto">
          <ItemsControl ItemsSource="{Binding DataContext.Handoff.WorkedItems, RelativeSource={RelativeSource AncestorType={x:Type Window}}}">
              <ItemsControl.ItemTemplate>
                  <DataTemplate>
                      <Border Padding="8" Margin="0,0,0,6" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}">
                          <Grid>
                              <Grid.ColumnDefinitions>
                                  <ColumnDefinition Width="180" />
                                  <ColumnDefinition Width="*" />
                                  <ColumnDefinition Width="130" />
                                  <ColumnDefinition Width="Auto" />
                              </Grid.ColumnDefinitions>
                              <TextBlock Grid.Column="0" Margin="0,0,10,0" Text="{Binding IdentityDisplay}" TextWrapping="Wrap" FontWeight="SemiBold" />
                              <TextBlock Grid.Column="1" Margin="0,0,10,0" Text="{Binding TextDisplay}" TextWrapping="Wrap" />
                              <TextBlock Grid.Column="2" Margin="0,0,10,0" Text="{Binding CompletedDisplay}" VerticalAlignment="Center" Style="{StaticResource SubtleTextStyle}" />
                              <Button Grid.Column="3"
                                      Content="Remove"
                                      VerticalAlignment="Center"
                                      Command="{Binding DataContext.Handoff.DismissWorkedItemCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                      CommandParameter="{Binding}"
                                      automation:AutomationProperties.Name="Remove completed item from future Handoffs" />
                          </Grid>
                      </Border>
                  </DataTemplate>
              </ItemsControl.ItemTemplate>
          </ItemsControl>
      </ScrollViewer>
  </StackPanel>
        </Border>
    </Grid>
</UserControl>
