<UserControl x:Class="Waa.App.Views.MissingBolTaskView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Waa.App.ViewModels"
             xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="1040" HorizontalAlignment="Center">
            <Border Style="{StaticResource PanelCardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitleStyle}" />
                        <TextBlock Margin="0,3,0,0" Text="{Binding Driver.DriverName}" FontSize="17" FontWeight="SemiBold" />
                        <TextBlock Margin="0,2,0,0" Text="{Binding Driver.IdentityLine}" Style="{StaticResource SubtleTextStyle}" />
                    </StackPanel>
                    <Border Grid.Column="1" Margin="18,0,0,0" Padding="12,7" VerticalAlignment="Top" Background="{DynamicResource PanelSubtleBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4">
                        <TextBlock Text="{Binding Item.StatusDisplay}" FontWeight="SemiBold">
                            <TextBlock.Style>
                                <Style TargetType="{x:Type TextBlock}">
                                    <Setter Property="Foreground" Value="{DynamicResource QuietTextBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Item.SemanticState}" Value="{x:Static vm:SemanticState.Warning}"><Setter Property="Foreground" Value="{DynamicResource WarningTextBrush}" /></DataTrigger>
                                        <DataTrigger Binding="{Binding Item.SemanticState}" Value="{x:Static vm:SemanticState.FollowUp}"><Setter Property="Foreground" Value="{DynamicResource FollowUpTextBrush}" /></DataTrigger>
                                        <DataTrigger Binding="{Binding Item.SemanticState}" Value="{x:Static vm:SemanticState.Completed}"><Setter Property="Foreground" Value="{DynamicResource CompletedTextBrush}" /></DataTrigger>
                                        <DataTrigger Binding="{Binding Item.SemanticState}" Value="{x:Static vm:SemanticState.Information}"><Setter Property="Foreground" Value="{DynamicResource InformationTextBrush}" /></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>
                </Grid>
            </Border>

            <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Border Grid.Column="0" Margin="0,0,5,0" Style="{StaticResource PanelCardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="145" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Order #" Style="{StaticResource SubtleTextStyle}" /><TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Item.OrderNumber}" FontWeight="SemiBold" />
                        <TextBlock Grid.Row="1" Margin="0,8,0,0" Text="Empty Call Date" Style="{StaticResource SubtleTextStyle}" /><TextBlock Grid.Row="1" Grid.Column="1" Margin="0,8,0,0" Text="{Binding Item.EmptyCallDateDisplay}" />
                        <TextBlock Grid.Row="2" Margin="0,8,0,0" Text="Route" Style="{StaticResource SubtleTextStyle}" /><TextBlock Grid.Row="2" Grid.Column="1" Margin="0,8,0,0" Text="{Binding Item.RouteDisplay}" />
                        <TextBlock Grid.Row="3" Margin="0,8,0,0" Text="Customer" Style="{StaticResource SubtleTextStyle}" /><TextBlock Grid.Row="3" Grid.Column="1" Margin="0,8,0,0" Text="{Binding Item.CustomerDisplay}" />
                        <TextBlock Grid.Row="4" Margin="0,8,0,0" Text="Miles" Style="{StaticResource SubtleTextStyle}" /><TextBlock Grid.Row="4" Grid.Column="1" Margin="0,8,0,0" Text="{Binding Item.MilesDisplay}" />
                    </Grid>
                </Border>
                <Border Grid.Column="1" Margin="5,0,0,0" Style="{StaticResource PanelCardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="155" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Source Driver Code" Style="{StaticResource SubtleTextStyle}" /><TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Item.SourceDriverCodeDisplay}" FontWeight="SemiBold" />
                        <TextBlock Grid.Row="1" Margin="0,8,0,0" Text="Source Driver Name" Style="{StaticResource SubtleTextStyle}" /><TextBlock Grid.Row="1" Grid.Column="1" Margin="0,8,0,0" Text="{Binding Item.SourceDriverNameDisplay}" />
                        <TextBlock Grid.Row="2" Margin="0,8,0,0" Text="Latest Report" Style="{StaticResource SubtleTextStyle}" /><TextBlock Grid.Row="2" Grid.Column="1" Margin="0,8,0,0" Text="{Binding Item.PresenceDisplay}" />
                        <TextBlock Grid.Row="3" Margin="0,8,0,0" Text="Unit" Style="{StaticResource SubtleTextStyle}" /><TextBlock Grid.Row="3" Grid.Column="1" Margin="0,8,0,0" Text="{Binding Driver.UnitCode}" />
                        <TextBlock Grid.Row="4" Margin="0,8,0,0" Text="Driver Leader" Style="{StaticResource SubtleTextStyle}" /><TextBlock Grid.Row="4" Grid.Column="1" Margin="0,8,0,0" Text="{Binding Driver.DriverLeader}" />
                    </Grid>
                </Border>
            </Grid>

            <Border Margin="0,10,0,0" Padding="12,9" Background="{DynamicResource WarningBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Visibility="{Binding Item.HasPresenceWarning, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock Text="{Binding Item.PresenceWarning}" Style="{StaticResource WarningTextStyle}" />
            </Border>
            <Border Margin="0,10,0,0" Padding="12,9" Background="{DynamicResource InformationBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Visibility="{Binding Item.HasNameWarning, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock Text="{Binding Item.NameWarning}" Style="{StaticResource InformationTextStyle}" />
            </Border>

            <Border Margin="0,10,0,0" Style="{StaticResource PanelCardStyle}">
                <StackPanel>
                    <TextBlock Text="ACTION" Style="{StaticResource SectionTitleStyle}" />
                    <TextBlock Text="Optional note" FontWeight="SemiBold" />
                    <TextBox Margin="0,5,0,0" MinHeight="86" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" Text="{Binding Item.Note, UpdateSourceTrigger=PropertyChanged}" automation:AutomationProperties.Name="Optional Missing BOL action note" />
                    <WrapPanel Margin="0,10,0,0">
                        <Button Margin="0,0,8,8" Content="Requested" Command="{Binding Item.RequestedCommand}" automation:AutomationProperties.Name="Save Requested Missing BOL outcome" />
                        <Button Margin="0,0,8,8" Content="Attempted" Command="{Binding Item.AttemptedCommand}" automation:AutomationProperties.Name="Save Attempted Missing BOL outcome" />
                        <Button Margin="0,0,8,8" Content="Follow-up" Command="{Binding Item.FollowUpCommand}" automation:AutomationProperties.Name="Save Follow-up Missing BOL outcome" />
                        <Button Margin="0,0,8,8" Content="Resolved" Command="{Binding Item.ResolvedCommand}" Style="{StaticResource PrimaryButtonStyle}" automation:AutomationProperties.Name="Resolve Missing BOL item" />
                        <Button Margin="0,0,8,8" Content="Reopen" Command="{Binding Item.ReopenCommand}" automation:AutomationProperties.Name="Reopen Missing BOL item" />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <Border Margin="0,10,0,0" Style="{StaticResource PanelCardStyle}">
                <StackPanel>
                    <TextBlock Text="ACTION HISTORY" Style="{StaticResource SectionTitleStyle}" />
                    <ItemsControl ItemsSource="{Binding History}" Visibility="{Binding HasHistory, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,6" Padding="10,8" Background="{DynamicResource PanelSubtleBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="120" /><ColumnDefinition Width="*" /><ColumnDefinition Width="180" /></Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding OutcomeDisplay}" FontWeight="SemiBold" />
                                        <StackPanel Grid.Column="1" Margin="10,0"><TextBlock Text="{Binding NoteDisplay}" /><TextBlock Margin="0,2,0,0" Text="{Binding ContextDisplay}" Style="{StaticResource SubtleTextStyle}" /></StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding CreatedDisplay}" HorizontalAlignment="Right" Style="{StaticResource SubtleTextStyle}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="No local action history has been recorded for this order.">
                        <TextBlock.Style>
                            <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource SubtleTextStyle}">
                                <Style.Triggers><DataTrigger Binding="{Binding HasHistory}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>

            <WrapPanel Margin="0,10,0,0" HorizontalAlignment="Right">
                <Button Margin="0,0,8,0" Content="Next Work Item" Command="{Binding DataContext.NextWorkItemCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" automation:AutomationProperties.Name="Open next work item" />
                <Button Content="Next Needing Attention" Command="{Binding DataContext.NextNeedingAttentionCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" automation:AutomationProperties.Name="Open next driver needing attention" />
            </WrapPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
