<UserControl x:Class="Waa.App.Views.MissingBolTaskView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="1040" HorizontalAlignment="Center">
            <Border Style="{StaticResource PanelCardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitleStyle}" />
                        <TextBlock Margin="0,3,0,0" Text="{Binding Driver.DriverName}" FontSize="17" FontWeight="SemiBold" />
                        <TextBlock Margin="0,2,0,0" Text="{Binding Driver.IdentityLine}" Style="{StaticResource SubtleTextStyle}" />
                    </StackPanel>
                    <Border Grid.Column="1"
                            Margin="18,0,0,0"
                            Padding="12,7"
                            VerticalAlignment="Top"
                            Background="{DynamicResource InformationBackgroundBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="4">
                        <TextBlock Text="{Binding Item.StatusDisplay}"
                                   Foreground="{DynamicResource InformationTextBrush}"
                                   FontWeight="SemiBold" />
                    </Border>
                </Grid>
            </Border>

            <Border Margin="0,10,0,0"
                    Padding="12,9"
                    Background="{DynamicResource InformationBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="4">
                <TextBlock Text="Read-only current report row. WAA does not store Missing BOL status, actions, notes, or history. If the row is removed from the workbook, it disappears from WAA after the next report update."
                           Style="{StaticResource InformationTextStyle}"
                           TextWrapping="Wrap" />
            </Border>

            <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Border Grid.Column="0" Margin="0,0,5,0" Style="{StaticResource PanelCardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="145" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Order #" Style="{StaticResource SubtleTextStyle}" /><TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Item.OrderNumber}" FontWeight="SemiBold" />
                        <TextBlock Grid.Row="1" Margin="0,8,0,0" Text="Empty Call Date" Style="{StaticResource SubtleTextStyle}" /><TextBlock Grid.Row="1" Grid.Column="1" Margin="0,8,0,0" Text="{Binding Item.EmptyCallDateDisplay}" />
                        <TextBlock Grid.Row="2" Margin="0,8,0,0" Text="Route" Style="{StaticResource SubtleTextStyle}" /><TextBlock Grid.Row="2" Grid.Column="1" Margin="0,8,0,0" Text="{Binding Item.RouteDisplay}" />
                        <TextBlock Grid.Row="3" Margin="0,8,0,0" Text="Customer" Style="{StaticResource SubtleTextStyle}" /><TextBlock Grid.Row="3" Grid.Column="1" Margin="0,8,0,0" Text="{Binding Item.CustomerDisplay}" />
                        <TextBlock Grid.Row="4" Margin="0,8,0,0" Text="Miles" Style="{StaticResource SubtleTextStyle}" /><TextBlock Grid.Row="4" Grid.Column="1" Margin="0,8,0,0" Text="{Binding Item.MilesDisplay}" />
                    </Grid>
                </Border>
                <Border Grid.Column="1" Margin="5,0,0,0" Style="{StaticResource PanelCardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="155" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Source Driver Code" Style="{StaticResource SubtleTextStyle}" /><TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Item.SourceDriverCodeDisplay}" FontWeight="SemiBold" />
                        <TextBlock Grid.Row="1" Margin="0,8,0,0" Text="Source Driver Name" Style="{StaticResource SubtleTextStyle}" /><TextBlock Grid.Row="1" Grid.Column="1" Margin="0,8,0,0" Text="{Binding Item.SourceDriverNameDisplay}" />
                        <TextBlock Grid.Row="2" Margin="0,8,0,0" Text="Source" Style="{StaticResource SubtleTextStyle}" /><TextBlock Grid.Row="2" Grid.Column="1" Margin="0,8,0,0" Text="{Binding Item.PresenceDisplay}" />
                        <TextBlock Grid.Row="3" Margin="0,8,0,0" Text="Unit" Style="{StaticResource SubtleTextStyle}" /><TextBlock Grid.Row="3" Grid.Column="1" Margin="0,8,0,0" Text="{Binding Driver.UnitCode}" />
                        <TextBlock Grid.Row="4" Margin="0,8,0,0" Text="Driver Leader" Style="{StaticResource SubtleTextStyle}" /><TextBlock Grid.Row="4" Grid.Column="1" Margin="0,8,0,0" Text="{Binding Driver.DriverLeader}" />
                    </Grid>
                </Border>
            </Grid>

            <Border Margin="0,10,0,0"
                    Padding="12,9"
                    Background="{DynamicResource InformationBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Visibility="{Binding Item.HasNameWarning, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock Text="{Binding Item.NameWarning}" Style="{StaticResource InformationTextStyle}" TextWrapping="Wrap" />
            </Border>

            <WrapPanel Margin="0,10,0,0" HorizontalAlignment="Right">
                <Button Margin="0,0,8,0"
                        Content="Next Work Item"
                        Command="{Binding DataContext.NextWorkItemCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                        automation:AutomationProperties.Name="Open next actual work item" />
                <Button Content="Next Needing Attention"
                        Command="{Binding DataContext.NextNeedingAttentionCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                        automation:AutomationProperties.Name="Open next driver needing attention" />
            </WrapPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>