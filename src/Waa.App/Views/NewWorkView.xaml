<UserControl x:Class="Waa.App.Views.NewWorkView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="900" HorizontalAlignment="Center">
            <Border Style="{StaticResource PanelCardStyle}">
                <StackPanel>
                    <TextBlock Text="Add Work" Style="{StaticResource PageTitleStyle}" />
                    <TextBlock Margin="0,3,0,0" Text="{Binding Driver.DriverName}" FontSize="17" FontWeight="SemiBold" />
                    <TextBlock Margin="0,2,0,0" Text="{Binding Driver.IdentityLine}" Style="{StaticResource SubtleTextStyle}" />
                    <TextBlock Margin="0,2,0,0" Style="{StaticResource SubtleTextStyle}">
                        <Run Text="Report cycle " />
                        <Run Text="{Binding Driver.Record.ReportCycleDate, StringFormat={}{0:M/d/yyyy}}" />
                    </TextBlock>
                </StackPanel>
            </Border>

            <Border Margin="0,10,0,0" Style="{StaticResource PanelCardStyle}">
                <StackPanel>
                    <TextBlock Text="WORK DETAILS" Style="{StaticResource SectionTitleStyle}" />
                    <TextBlock Text="Describe the work clearly enough that it still makes sense during handoff." Style="{StaticResource SubtleTextStyle}" />
                    <TextBox Margin="0,8,0,0"
                             MinHeight="180"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalContentAlignment="Top"
                             Text="{Binding DataContext.Work.NewWorkText, RelativeSource={RelativeSource AncestorType={x:Type Window}}, UpdateSourceTrigger=PropertyChanged}"
                             automation:AutomationProperties.Name="New work description" />
                    <WrapPanel Margin="0,12,0,0">
                        <Button Margin="0,0,8,8"
                                Content="Done"
                                Command="{Binding DataContext.Work.SaveDoneCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                automation:AutomationProperties.Name="Save completed work" />
                        <Button Margin="0,0,8,8"
                                Content="Waiting"
                                Command="{Binding DataContext.Work.SaveWaitingCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                automation:AutomationProperties.Name="Save waiting work" />
                        <Button Margin="0,0,8,8"
                                Content="Follow-up"
                                Command="{Binding DataContext.Work.SaveFollowUpCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                automation:AutomationProperties.Name="Save follow-up work" />
                    </WrapPanel>
                    <TextBlock Margin="0,6,0,0"
                               Text="After a successful save, WAA returns to this driver's workspace and keeps the new item in context."
                               Style="{StaticResource SubtleTextStyle}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
