<UserControl x:Class="Waa.App.Views.WorkItemTaskView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="980" HorizontalAlignment="Center">
            <Border Style="{StaticResource PanelCardStyle}">
                <StackPanel>
                    <TextBlock Text="Work Item" Style="{StaticResource PageTitleStyle}" />
                    <TextBlock Margin="0,3,0,0" Text="{Binding Driver.DriverName}" FontSize="17" FontWeight="SemiBold" />
                    <TextBlock Margin="0,2,0,0" Text="{Binding Driver.IdentityLine}" Style="{StaticResource SubtleTextStyle}" />
                </StackPanel>
            </Border>

            <Border Margin="0,10,0,0" Style="{StaticResource PanelCardStyle}">
                <StackPanel>
                    <TextBlock Text="WORK" Style="{StaticResource SectionTitleStyle}" />
                    <TextBlock Text="{Binding Item.Text}" FontSize="16" />
                </StackPanel>
            </Border>

            <Border Margin="0,10,0,0" Style="{StaticResource PanelCardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="160" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Original Status" Style="{StaticResource SubtleTextStyle}" />
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Item.StatusDisplay}" FontWeight="SemiBold" />
                    <TextBlock Grid.Row="0" Grid.Column="2" Text="Source" Style="{StaticResource SubtleTextStyle}" />
                    <TextBlock Grid.Row="0" Grid.Column="3" Text="{Binding Item.SourceDisplay}" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,9,0,0" Text="Created" Style="{StaticResource SubtleTextStyle}" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,9,0,0" Text="{Binding Item.CreatedFullDisplay}" />
                    <TextBlock Grid.Row="1" Grid.Column="2" Margin="0,9,0,0" Text="Resolution" Style="{StaticResource SubtleTextStyle}" />
                    <TextBlock Grid.Row="1" Grid.Column="3" Margin="0,9,0,0" Text="{Binding Item.ResolutionDisplay}" />

                    <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,9,0,0" Text="Unit Snapshot" Style="{StaticResource SubtleTextStyle}" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Margin="0,9,0,0" Text="{Binding Item.UnitCodeDisplay}" />
                    <TextBlock Grid.Row="2" Grid.Column="2" Margin="0,9,0,0" Text="Leader Snapshot" Style="{StaticResource SubtleTextStyle}" />
                    <TextBlock Grid.Row="2" Grid.Column="3" Margin="0,9,0,0" Text="{Binding Item.DriverLeaderDisplay}" />

                    <TextBlock Grid.Row="3" Grid.Column="0" Margin="0,9,0,0" Text="Report Cycle" Style="{StaticResource SubtleTextStyle}" />
                    <TextBlock Grid.Row="3" Grid.Column="1" Margin="0,9,0,0" Text="{Binding Item.ReportCycleDisplay}" />
                    <TextBlock Grid.Row="3" Grid.Column="2" Margin="0,9,0,0" Text="Driver Code" Style="{StaticResource SubtleTextStyle}" />
                    <TextBlock Grid.Row="3" Grid.Column="3" Margin="0,9,0,0" Text="{Binding Driver.DriverCode}" />
                </Grid>
            </Border>

            <Border Margin="0,10,0,0"
                    Padding="12,9"
                    Background="{DynamicResource InformationBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Visibility="{Binding Item.UsesMissingBolControls, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock Text="{Binding Item.ResolutionInstruction}" Style="{StaticResource InformationTextStyle}" />
            </Border>

            <WrapPanel Margin="0,10,0,0">
                <Button Margin="0,0,8,8"
                        Content="Resolve"
                        Command="{Binding Item.ResolveCommand}"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Visibility="{Binding Item.CanResolve, Converter={StaticResource BooleanToVisibilityConverter}}"
                        automation:AutomationProperties.Name="Resolve this work item" />
                <Button Margin="0,0,8,8"
                        Content="Reopen"
                        Command="{Binding Item.ReopenCommand}"
                        Visibility="{Binding Item.CanReopen, Converter={StaticResource BooleanToVisibilityConverter}}"
                        automation:AutomationProperties.Name="Reopen this work item" />
                <Button Margin="0,0,8,8"
                        Content="Next Work Item"
                        Command="{Binding DataContext.NextWorkItemCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                        automation:AutomationProperties.Name="Open next work item" />
                <Button Margin="0,0,8,8"
                        Content="Next Needing Attention"
                        Command="{Binding DataContext.NextNeedingAttentionCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                        automation:AutomationProperties.Name="Open next driver needing attention" />
            </WrapPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
